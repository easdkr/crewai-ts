# @crewai-ts/nestjs-demo — environment (NAMES ONLY; never commit real values).
# The demo reads these from process.env. Copy to `.env` OR just export them in
# your shell (e.g. they already live in ~/.zshrc). `.env` is gitignored.
#
# Run with an env file:   pnpm --filter @crewai-ts/nestjs-demo exec tsx --env-file=.env src/main.ts
# Or rely on the shell:   pnpm --filter @crewai-ts/nestjs-demo start

# Which provider backs `llms.default`. One of: openai | gemini | anthropic.
# If unset, the demo auto-selects the first provider whose key is present,
# in this order: openai -> gemini -> anthropic.
LLM_PROVIDER=

# --- OpenAI (public endpoint) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Gemini (public endpoint) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic ---
# Core expects ANTHROPIC_API_KEY. If only CLAUDE_API_KEY is set, the demo
# bridges it (CLAUDE_API_KEY -> ANTHROPIC_API_KEY) automatically.
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Route Anthropic through a custom/base URL (e.g. a local proxy). The demo
# passes this to the provider explicitly (core does not auto-read it).
ANTHROPIC_BASE_URL=

# HTTP port for the demo server.
PORT=3000
