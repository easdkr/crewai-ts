{
  "name": "@crewai-ts/a2a",
  "version": "0.2.0",
  "description": "Agent-to-agent protocol and A2UI features for CrewAI TypeScript.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easdkr/crewai-ts.git",
    "directory": "packages/a2a"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./a2a": {
      "types": "./dist/a2a.d.ts",
      "import": "./dist/a2a.js",
      "require": "./dist/a2a.cjs",
      "default": "./dist/a2a.js"
    },
    "./a2ui": {
      "types": "./dist/a2ui.d.ts",
      "import": "./dist/a2ui.js",
      "require": "./dist/a2ui.cjs",
      "default": "./dist/a2ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "postbuild": "node --input-type=module -e \"import('./dist/index.js')\"",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@crewai-ts/core": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
